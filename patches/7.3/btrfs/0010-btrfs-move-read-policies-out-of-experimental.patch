--- a/fs/btrfs/sysfs.h
+++ b/fs/btrfs/sysfs.h
@@ -49,9 +49,9 @@ void btrfs_sysfs_del_one_qgroup(struct btrfs_fs_info *fs_info,
 				struct btrfs_qgroup *qgroup);
 int btrfs_read_policy_to_enum(const char *str, s64 *value);
 
