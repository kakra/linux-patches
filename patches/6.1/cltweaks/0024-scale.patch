diff --git a/mm/memcontrol.c b/mm/memcontrol.c
index 266a1ab054341..25a5289cb334d 100644
--- a/mm/memcontrol.c
+++ b/mm/memcontrol.c
@@ -611,7 +611,7 @@ static inline void memcg_rstat_updated(struct mem_cgroup *memcg, int val)
