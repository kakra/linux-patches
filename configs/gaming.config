# Options needed to build the gaming series
CONFIG_ZEN_INTERACTIVE=y
CONFIG_BLOCK=y
CONFIG_IOSCHED_BFQ=y
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_MQ_IOSCHED_ADIOS=y
CONFIG_MQ_IOSCHED_DEFAULT_ADIOS=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_SWAP=y
CONFIG_LRU_GEN=y
CONFIG_PCI=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_CPU_SUP_INTEL=y
# le9uo uses its Kconfig defaults unconditionally, which only exist with SYSCTL
CONFIG_PROC_FS=y
CONFIG_SYSCTL=y
